{
  "manifest_version": 3,
  "name": "SEO Inspector - On-Page Technical Diagnostics",
  "version": "1.0.0",
  "description": "Instant on-page technical SEO inspector: Meta, Headings, Links, Hreflangs, Images, JSON-LD Schema, Performance & Issues.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SEO Inspector"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "512": "icons/icon-512.png"
  }
}
